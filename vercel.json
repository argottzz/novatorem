{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "https://github.com/argottzz/novatorem"
      }
    }
  ]
}
